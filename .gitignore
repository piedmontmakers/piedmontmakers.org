# Claude Code local cache and per-user settings. Portable project skills are
# symlinked to the canonical .agents copies below.
.claude/skills/*
!.claude/skills/web-verify
!.claude/skills/project-bootstrap
.claude/settings.local.json

# Ignore generated skill caches while keeping the two project-owned skills.
.agents/skills/*
!.agents/skills/web-verify/
!.agents/skills/web-verify/**
!.agents/skills/project-bootstrap/
!.agents/skills/project-bootstrap/**
.codex/skills/

# Browser regression artifacts
/test-results/
/playwright-report/
