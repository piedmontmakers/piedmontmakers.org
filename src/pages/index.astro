---
import { eventDateParts } from "../lib/event-time";
import { link, asset } from "../lib/urls";
import { eventAnchor } from "../lib/events";
import { levels } from "../data/robotics-levels";
import { programs } from "../data/programs";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Ribbon from "../components/Ribbon.astro";
import PhotoCard from "../components/PhotoCard.astro";
import Scribble from "../components/Scribble.astro";
import StatsBand from "../components/StatsBand.astro";
import VoicesBand from "../components/VoicesBand.astro";
import { stats } from "../data/stats";
import { voices } from "../data/voices";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const latestPosts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// timeZone: "UTC" because YAML dates parse as midnight UTC; without it the
// displayed day shifts back one on West-Coast / non-UTC builds.
const formatDate = (d: Date) =>
  d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });

const blogThumbFallback = "/img/brand/makey.png";

// Render all events; the browser keeps the current window accurate between builds.
const upcomingEvents = (await getCollection("events"))
  .sort((a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf());

// YAML dates parse as midnight UTC; format with UTC methods so the day number
// matches the frontmatter regardless of the build server's timezone.



// Mailchimp audience details extracted from the unsubscribe link in the
// January 2026 newsletter campaign. Hidden honeypot input name must be
// `b_{u}_{id}` so Mailchimp's bot filter recognizes it.
const MAILCHIMP_ACTION = "https://piedmontmakers.us3.list-manage.com/subscribe/post?u=edc89d8dd41a4ea6ee9352d9a&id=83b9d5d7df";
const MAILCHIMP_HONEYPOT_NAME = "b_edc89d8dd41a4ea6ee9352d9a_83b9d5d7df";

// The homepage keeps its own short copy (names, ages, taglines, blurbs); photos,
// captions, alt text, colors, and links come from the shared data so they cannot
// drift from the program pages. Edit facts in src/data/, edit this voice here.
const homeLevelCopy: Record<string, { name: string; ages: string }> = {
  "fll-explore": { name: "FIRST LEGO League Explore", ages: "K–3rd" },
  "fll-challenge": { name: "FIRST LEGO League Challenge", ages: "4th–8th" },
  ftc: { name: "FIRST Tech Challenge", ages: "7th–12th" },
  frc: { name: "FIRST Robotics Competition", ages: "high school" },
};
const roboticsLevels = levels.map((level) => ({
  slug: level.slug, blurb: level.homeBlurb,
  color: level.color, src: level.photoSrc, caption: level.photoCaption, alt: level.photoAlt,
  ...(homeLevelCopy[level.slug] ?? { name: level.name, ages: level.ageLabel }),
}));

const homeEventCopy: Record<string, { when: string; headline: string; blurb: string }> = {
  "/events/maker-faire": {
    when: "Annual · next May 2027",
    headline: "Our biggest event of the year",
    blurb: "K-12 kids show what they made all year: Rube Goldberg machines, robots, embroidered patches, soldered circuits, 3D-printed everything. Free, open to the public.",
  },
  "/events/popup-maker-spaces": {
    when: "Sporadic Saturdays · Sign up to hear first",
    headline: "Hands-on workshops, drop in and make",
    blurb: "A few times a year we open a space and load it with tools: soldering irons, sewing machines, 3D printers, cardboard, hot glue, whatever's on hand. Show up and make.",
  },
  "/events/build-like-a-girl": {
    when: "Multiple sessions · Watch the newsletter",
    headline: "Inspiring girls in STEAM",
    blurb: "Older girls from our FRC and FTC teams teach the younger ones. Hands-on robotics with serious tools. By girls, for girls.",
  },
};
const featuredPaths = Object.keys(homeEventCopy);
const events = featuredPaths.map((href) => ({ ...programs.find((program) => program.href === href)!, ...homeEventCopy[href] }));

---

<BaseLayout title="Piedmont Makers — STEAM, robotics & maker culture for East Bay kids">
  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-pm-cream"></div>

    <div class="mx-auto max-w-7xl px-6 pt-10 md:pt-16 pb-20 md:pb-28">
      <div class="grid md:grid-cols-12 gap-8 md:gap-12 items-center">
        <div class="md:col-span-6 md:order-1">
          <Ribbon color="red">Welcome</Ribbon>
          <h1 class="mt-6 font-display font-bold tracking-tight text-pm-ink text-5xl md:text-6xl lg:text-7xl leading-[0.95]">
            Where East Bay kids learn to
            <span class="relative inline-block">
              <span class="relative z-10">make.</span>
              <Scribble variant="underline" color="red" class="absolute -bottom-2 left-0 w-full h-3" />
            </span>
          </h1>
          <p class="mt-7 max-w-xl text-lg md:text-xl text-pm-ink/75 leading-relaxed">
            We run the <strong>largest community-based youth robotics league in the United States</strong>, a community engineering lab, a yearly school maker faire, and popup maker spaces across the East Bay. Run by parents and volunteers.
          </p>
          <div class="mt-10 flex flex-wrap items-center gap-3">
            <a href={link("/robotics")} class="ribbon bg-pm-red text-white text-base hover:bg-pm-red-deep transition-colors">Sign your kid up</a>
            <a href="#newsletter" class="inline-flex items-center gap-2 rounded-full border-2 border-pm-ink px-5 py-2.5 font-display font-semibold text-pm-ink hover:bg-pm-ink hover:text-pm-cream transition-colors">
              Get our newsletter
            </a>
            <span class="font-marker text-2xl text-pm-purple ml-2 hidden md:inline-block">since 2014!</span>
          </div>
        </div>

        <div class="md:col-span-6 md:order-2 relative">
          <!-- Mobile: single hero photo. The 3-photo collage doesn't compose well
               below ~640px width — photos shrink too much to overlap meaningfully
               and leave dead vertical space. -->
          <div class="md:hidden">
            <figure class="tilt-right">
              <div class="overflow-hidden rounded-3xl border-[5px] border-pm-red shadow-[var(--shadow-card)] aspect-[4/3]">
                <img
                  src={asset("/img/programs/build-like-a-girl.jpg")}
                  alt="High school students from FRC Team 8033 in purple Piedmont Makers sweatshirts demonstrating a robot to a crowd of younger girls."
                  class="w-full h-full object-cover"
                  loading="eager"
                />
              </div>
            </figure>
          </div>

          <!-- Desktop: full 3-photo collage with the deliberate overlap. -->
          <div class="hidden md:block relative h-[540px]">
            <!-- Bottom: Maker Faire LEGO table — cyan border, landscape so it sits below BLAG instead of climbing into it -->
            <div class="absolute bottom-0 left-[12%] w-[70%] aspect-[4/3] rounded-3xl overflow-hidden border-[5px] border-pm-cyan shadow-[var(--shadow-card)] tilt-left-md z-10">
              <img
                src={asset("/img/programs/maker-faire.jpg")}
                alt="Kids and parents gathered around a large outdoor LEGO play table at the Piedmont School Maker Faire."
                class="w-full h-full object-cover"
                style="object-position: 50% 55%;"
                loading="eager"
              />
            </div>
            <!-- Top-left: parade Makey balloon — purple border (Makey is purple), bigger + nudged down/right so it tucks into the seam between the red and cyan cards -->
            <div class="absolute top-[4%] left-0 md:-left-1 w-[44%] aspect-square rounded-2xl overflow-hidden border-[5px] border-pm-purple shadow-[var(--shadow-card)] tilt-left-md z-20">
              <img
                src={asset("/img/programs/parade.jpg")}
                alt="The giant red inflatable Makey rising above the 4th of July Parade — kids in purple Piedmont Makers shirts hold the banner below, red-white-and-blue balloons frame Makey on either side, and a kid in a soapbox car cruises past."
                class="w-full h-full object-cover"
                style="object-position: 52% 60%;"
                loading="eager"
              />
            </div>
            <!-- Top-right: Build Like a Girl — red border. Last so its bottom-left corner sits ON TOP of the cyan card. -->
            <div class="absolute top-0 right-0 w-[64%] aspect-[4/3] rounded-3xl overflow-hidden border-[5px] border-pm-red shadow-[var(--shadow-card)] tilt-right z-30">
              <img
                src={asset("/img/programs/build-like-a-girl.jpg")}
                alt="High school students from FRC Team 8033 in purple Piedmont Makers sweatshirts demonstrating a robot to a crowd of younger girls."
                class="w-full h-full object-cover"
                loading="eager"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- STATS BAND — community in numbers, builds confidence -->
  <StatsBand
    stats={[
      { number: stats.kidsOnTeams, label: "kids on robotics teams" },
      { number: stats.schools, label: `schools across ${stats.cities} East Bay cities` },
      { number: "$25K+", label: "in teacher grants annually" },
      { number: stats.girlsInLegoLeague, label: "girls in LEGO League" },
    ]}
  />

  <!-- COMING UP — calendar events within the next 30 days. Hidden by default;
       the inline script at the bottom reveals it only when at least one
       rendered row falls inside the window (and hides it otherwise). Mirrors
       /calendar's client-side date logic so the window stays correct without a
       rebuild. -->
  <section data-upcoming-section class="hidden mx-auto max-w-7xl px-6 pt-16 md:pt-20">
    <div class="rounded-2xl border-[3px] border-pm-cyan bg-pm-cyan/[0.07] p-6 md:p-7">
      <div class="flex items-center gap-4 pb-4 mb-1 border-b border-pm-ink/10">
        <Ribbon color="cyan">Coming up</Ribbon>
        <span class="font-marker text-xl text-pm-purple hidden sm:inline">Don&apos;t miss it!</span>
        <a href={link("/calendar")} class="ml-auto inline-flex items-center gap-1.5 font-display font-semibold text-sm text-pm-ink hover:text-pm-red underline-offset-4 hover:underline whitespace-nowrap">Full calendar →</a>
      </div>
      <ul class="divide-y divide-pm-ink/10">
        {upcomingEvents.map((e) => {
          const p = eventDateParts(e.data.startDate);
          const end = e.data.endDate ? eventDateParts(e.data.endDate) : null;
          // Same-month range shows as "8–12" / "Mon–Fri"; the box stays anchored
          // on the start date. Mirrors /calendar's multi-day treatment.
          const sameMonthRange =
            end !== null && end.iso !== p.iso && end.month === p.month && end.year === p.year;
          const timeRange = e.data.startTime && e.data.endTime
            ? `${e.data.startTime} – ${e.data.endTime}`
            : (e.data.startTime || null);
          const weekday = sameMonthRange && end ? `${p.weekday}–${end.weekday}` : p.weekday;
          const metaLine = [weekday, timeRange, e.data.location].filter(Boolean).join(" · ");
          // Link to the event's row on /calendar (anchored by date) rather than
          // its first action, so visitors see every link — register, tickets,
          // the Meet URL — instead of being dropped on one destination.
          const rowHref = `${link("/calendar")}#${eventAnchor(e.id)}`;
          return (
            <li class="hidden" data-event-date={p.iso} data-event-end={end?.iso ?? p.iso}>
              <a href={rowHref} data-upcoming-link data-event-title={e.data.title} class="group flex items-center gap-4 py-3.5">
                <div class="shrink-0 w-12 text-center">
                  <div class="font-display text-[0.62rem] uppercase tracking-[0.18em] text-pm-red font-semibold leading-none">{p.month}</div>
                  <div class:list={["mt-1 font-display font-bold leading-none text-pm-ink", sameMonthRange ? "text-xl tracking-tight" : "text-2xl"]}>
                    {sameMonthRange && end ? `${p.day}–${end.day}` : p.day}
                  </div>
                </div>
                <div class="min-w-0 flex-1">
                  <h3 class="font-display font-bold text-lg tracking-tight leading-tight group-hover:text-pm-red transition-colors">{e.data.title}</h3>
                  {metaLine && <p class="text-sm text-pm-ink/65">{metaLine}</p>}
                </div>
                <span aria-hidden="true" class="shrink-0 font-display text-lg text-pm-ink/35 group-hover:text-pm-red group-hover:translate-x-0.5 transition-all">→</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- ROBOTICS — the flagship program, deep dive -->
  <section class="relative">
    <div class="mx-auto max-w-7xl px-6 pt-20 pb-12">
      <div class="grid md:grid-cols-12 gap-10 mb-12 items-end">
        <div class="md:col-span-7">
          <Ribbon color="red">Robotics</Ribbon>
          <h2 class="mt-5 font-display font-bold text-4xl md:text-5xl tracking-tight leading-[1.02]">
            From LEGO bricks to championship robots.
          </h2>
          <p class="mt-5 text-lg text-pm-ink/75 leading-relaxed max-w-xl">
            Whether your kid is snapping a LEGO brick for the first time or driving a 120-pound competition robot at the championship, we have a team that fits.
          </p>
        </div>
        <div class="md:col-span-5 md:text-right">
          <a href={link("/robotics")} class="inline-flex items-center gap-2 font-display font-semibold text-pm-ink hover:text-pm-red underline-offset-4 hover:underline">
            See the full Robotics page →
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-5 gap-y-10">
        {roboticsLevels.map((lvl, i) => (
          <a href={`${link("/robotics")}#${lvl.slug}`} class="group block">
            <Ribbon color={lvl.color}>{lvl.name}</Ribbon>
            <p class="mt-3 font-display text-xs uppercase tracking-[0.18em] text-pm-ink/70">Ages · {lvl.ages}</p>
            <div class="mt-4">
              <PhotoCard
                caption={lvl.caption}
                color={lvl.color}
                tilt={i % 2 === 0 ? "left" : "right"}
                tape={i === 1 ? "right" : "none"}
                aspect="square"
                src={lvl.src}
                alt={lvl.alt}
              />
            </div>
            <p class="mt-3 px-1 text-pm-ink/80 leading-relaxed text-[0.95rem]">{lvl.blurb}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- PROGRAMS — Maker Faire, Popup Maker Spaces, Build Like a Girl -->
  <section class="relative mt-12 bg-pm-cream-2/60">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="grid md:grid-cols-12 gap-10 mb-12 items-end">
        <div class="md:col-span-7">
          <Ribbon color="cyan">Events &amp; Programs</Ribbon>
          <h2 class="mt-5 font-display font-bold text-4xl md:text-5xl tracking-tight leading-[1.02]">
            Come make something with us.
          </h2>
          <p class="mt-5 text-lg text-pm-ink/75 leading-relaxed max-w-xl">
            Year-round community maker events for kids and grown-ups.
          </p>
        </div>
        <div class="md:col-span-5 md:text-right space-y-2">
          <a href={link("/events")} class="inline-flex items-center gap-2 font-display font-semibold text-pm-ink hover:text-pm-red underline-offset-4 hover:underline">
            All Our Programs →
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-x-6 gap-y-10">
        {events.map((e) => (
          <a href={link(e.href)} class="group block">
            <Ribbon color={e.color}>{e.name}</Ribbon>
            <p class="mt-3 font-display text-xs uppercase tracking-[0.18em] text-pm-ink/70">{e.when}</p>
            <h3 class="mt-2 font-display font-bold text-2xl tracking-tight leading-tight">{e.headline}</h3>
            <div class="mt-4">
              <PhotoCard
                caption={e.caption}
                color={e.color}
                tilt={e.tilt}
                tape={e.tape}
                aspect="landscape"
                src={e.src}
                alt={e.alt}
              />
            </div>
            <p class="mt-3 px-1 text-pm-ink/80 leading-relaxed">{e.blurb}</p>
            <p class="mt-4 px-1 font-display font-semibold text-pm-ink group-hover:text-pm-red transition-colors">
              {e.cta}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- VOICES BAND — community quote -->
  <VoicesBand voices={voices} eyebrow="From the community" />

  <!-- LATEST FROM THE BLOG -->
  <section class="mx-auto max-w-7xl px-6 pt-20 pb-4">
    <div class="grid md:grid-cols-12 gap-10 mb-12 items-end">
      <div class="md:col-span-7">
        <Ribbon color="ink">Blog</Ribbon>
        <h2 class="mt-5 font-display font-bold text-4xl md:text-5xl tracking-tight leading-[1.02]">
          Latest from the blog.
        </h2>
        <p class="mt-5 text-lg text-pm-ink/75 leading-relaxed max-w-xl">
          Project recaps, season updates, photos from the field. For sign-up windows and anything time-sensitive, the newsletter is faster.
        </p>
      </div>
      <div class="md:col-span-5 md:text-right">
        <a href={link("/blog")} class="inline-flex items-center gap-2 font-display font-semibold text-pm-ink hover:text-pm-red underline-offset-4 hover:underline">
          All posts →
        </a>
      </div>
    </div>

    <ul class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {latestPosts.map((post) => {
        const hasHero = !!post.data.heroImage;
        const thumbSrc = asset(post.data.heroImage || blogThumbFallback);
        const thumbAlt = post.data.heroImageAlt || (hasHero ? post.data.title : "Makey, the Piedmont Makers mascot");
        return (
          <li>
            <a href={link(`/blog/${post.id}`)} class="group block bg-pm-paper border-[3px] border-pm-ink h-full hover:bg-white transition-colors">
              <div class:list={["aspect-[16/10] overflow-hidden border-b-[3px] border-pm-ink", hasHero ? "" : "bg-pm-purple flex items-center justify-center p-4"]}>
                <img
                  src={thumbSrc}
                  alt={thumbAlt}
                  class:list={["w-full h-full", hasHero ? "object-cover" : "object-contain"]}
                  loading="lazy"
                />
              </div>
              <div class="p-6">
                <p class="font-display text-xs uppercase tracking-[0.18em] text-pm-ink/70">{formatDate(post.data.pubDate)}</p>
                <h3 class="mt-3 font-display font-bold text-xl md:text-2xl tracking-tight leading-tight group-hover:text-pm-red transition-colors">
                  {post.data.title}
                </h3>
                {post.data.excerpt && (
                  <p class="mt-3 text-pm-ink/75 leading-relaxed text-sm">{post.data.excerpt}</p>
                )}
                <p class="mt-5 font-display font-semibold text-pm-ink group-hover:text-pm-red transition-colors">
                  Read post →
                </p>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  <!-- STAY IN THE LOOP — full-bleed cyan newsletter band -->
  <section id="newsletter" class="bg-pm-cyan text-pm-ink scroll-mt-20">
    <div class="mx-auto max-w-7xl px-6 py-20 md:py-24">
      <div class="grid md:grid-cols-12 gap-10 items-center">
        <div class="md:col-span-7">
          <div class="inline-flex items-center gap-3">
            <span class="font-marker text-2xl text-pm-ink/90">psst —</span>
            <Ribbon color="ink">Newsletter</Ribbon>
          </div>
          <h2 class="mt-5 font-display font-bold text-4xl md:text-5xl tracking-tight leading-[1.02]">
            Don&apos;t miss what&apos;s next.
          </h2>
          <p class="mt-5 max-w-xl text-lg text-pm-ink/90 leading-relaxed">
            Upcoming programs for your kids, registration deadlines (some sessions close in hours), volunteer opportunities for grown-ups and kids both, and photos from recent events. About one email a month.
          </p>
        </div>
        <div class="md:col-span-5">
          <form
            action={MAILCHIMP_ACTION}
            method="post"
            target="_blank"
            class="bg-pm-paper text-pm-ink border-[3px] border-pm-ink p-7 shadow-[var(--shadow-card)]"
          >
            <p class="font-display text-xs uppercase tracking-[0.18em] text-pm-ink/70">Mailchimp · free · unsubscribe anytime</p>
            <label for="newsletter-email" class="block mt-3 font-display font-bold text-2xl md:text-[1.7rem] tracking-tight leading-tight">
              Get the newsletter
            </label>
            <div class="mt-4 flex flex-col sm:flex-row gap-2">
              <input
                type="email"
                name="EMAIL"
                id="newsletter-email"
                required
                placeholder="you@example.com"
                autocomplete="email"
                class="flex-1 min-w-0 border-2 border-pm-ink/30 focus:border-pm-ink focus:outline-none px-4 py-3 font-body bg-white text-pm-ink placeholder:text-pm-ink/40"
              />
              <button
                type="submit"
                name="subscribe"
                class="ribbon bg-pm-red text-white text-base hover:bg-pm-red-deep transition-colors cursor-pointer whitespace-nowrap"
              >
                Subscribe →
              </button>
            </div>
            <p class="mt-3 text-sm text-pm-ink/65 leading-relaxed">
              We&apos;ll open Mailchimp in a new tab to confirm. No spam, promise.
            </p>
            <div aria-hidden="true" style="position: absolute; left: -5000px;">
              <input type="text" name={MAILCHIMP_HONEYPOT_NAME} tabindex="-1" value="" />
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY WE MAKE — Makey -->
  <section class="bg-pm-purple text-white">
    <div class="mx-auto max-w-7xl px-6 py-20 md:py-24 grid md:grid-cols-12 gap-10 items-center">
      <div class="md:col-span-5 flex items-center justify-center md:justify-start">
        <img src={`${base}/img/brand/makey.png`} alt="Makey, the Piedmont Makers mascot" class="w-72 md:w-80 h-auto" />
      </div>
      <div class="md:col-span-7">
        <p class="font-marker text-3xl text-pm-cream/90">why we make</p>
        <h2 class="mt-2 font-display font-bold text-4xl md:text-5xl tracking-tight leading-[1.04]">
          When students build something with their own hands, they build something else too: belief in themselves.
        </h2>
        <p class="mt-6 text-lg text-white/85 leading-relaxed max-w-2xl">
          We&apos;re a 501(&zwnj;c)(3) run by parents and volunteers. Most of what we do is free or low-cost. Each year we give $25,000+ in STEAM grants to Piedmont Unified teachers, run robotics teams across the East Bay, host a community engineering lab, put on a school maker faire (now in its 12th year), and open popup maker spaces around the East Bay.
        </p>
        <p class="mt-4 text-lg text-white/85 leading-relaxed max-w-2xl">
          The reason it all works is the same reason most good community things work: a lot of people show up, regularly, and pitch in.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={link("/about-us")} class="ribbon bg-pm-cream text-pm-ink text-base hover:bg-white transition-colors">About Piedmont Makers</a>
          <a href={link("/events")} class="inline-flex items-center gap-2 rounded-full border-2 border-white px-5 py-2.5 font-display font-semibold text-white hover:bg-white hover:text-pm-purple transition-colors">
            Volunteer with us
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW TO HELP -->
  <section class="mx-auto max-w-7xl px-6 py-20 md:py-24">
    <div class="text-center max-w-3xl mx-auto">
      <Ribbon color="red">How to help</Ribbon>
      <h2 class="mt-5 font-display font-bold text-4xl md:text-5xl tracking-tight">
        Three ways to keep this going.
      </h2>
      <p class="mt-4 text-pm-ink/75 text-lg leading-relaxed">
        We&apos;re an entirely volunteer-run nonprofit. Any of these helps a lot.
      </p>
    </div>
    <div class="mt-12 grid md:grid-cols-3 gap-6">
      <a id="donate-home" href="https://donate.piedmontmakers.org" class="block rounded-3xl bg-pm-ink text-pm-cream p-8 hover:bg-pm-ink-soft transition-colors group">
        <span class="font-marker text-2xl text-pm-red">tax-deductible!</span>
        <h3 class="mt-2 font-display font-bold text-3xl tracking-tight">Donate</h3>
        <p class="mt-3 text-pm-cream/80 leading-relaxed">Direct to programs. Square-processed. Tax-deductible.</p>
        <p class="mt-6 font-display font-semibold text-pm-cream group-hover:text-pm-red transition-colors">Go to donate.piedmontmakers.org →</p>
      </a>
      <a id="volunteer-home" href={link("/events")} class="block rounded-3xl bg-pm-cyan text-pm-ink p-8 hover:bg-pm-cream transition-colors group">
        <span class="font-marker text-2xl text-pm-ink/80">we need you!</span>
        <h3 class="mt-2 font-display font-bold text-3xl tracking-tight">Volunteer</h3>
        <p class="mt-3 text-pm-ink/80 leading-relaxed">We&apos;re volunteer-run start to finish. Coach a team, mentor at Maker Faire, help with the next popup. Every event has its own signup.</p>
        <p class="mt-6 font-display font-semibold group-hover:text-pm-red transition-colors">See upcoming events →</p>
      </a>
      <a id="buy-shirt-home" href="https://www.bonfire.com/piedmont-makers-t-shirt/" class="block rounded-3xl bg-pm-cream-2 text-pm-ink p-8 hover:bg-pm-cream transition-colors group">
        <span class="font-marker text-2xl text-pm-purple">on Bonfire</span>
