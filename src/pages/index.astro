  </section>
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    // Newsletter signup. The form uses target="_blank", so the page stays put
    // and a visitor can hit Subscribe repeatedly — each submit would otherwise
    // fire a duplicate event. Guard so we capture at most once per page load.
    var newsletterForm = document.querySelector('#newsletter form');
    if (newsletterForm) {
      var newsletterCaptured = false;
      newsletterForm.addEventListener('submit', function () {
        if (newsletterCaptured) return;
        newsletterCaptured = true;
        window.posthog?.capture('newsletter_signup_clicked');
      });
    }

    // Donate card on the "How to help" strip — targeted by ID so we
    // don't accidentally pick up the nav's own donate ribbon (which lives
    // on every page including this one).
    var donateLink = document.getElementById('donate-home');
    if (donateLink) {
      donateLink.addEventListener('click', function () {
        window.posthog?.capture('donate_clicked', { source: 'home_how_to_help' });
      });
    }

    // Volunteer card on the same strip — ID for the same reason.
    var volunteerLink = document.getElementById('volunteer-home');
    if (volunteerLink) {
      volunteerLink.addEventListener('click', function () {
        window.posthog?.capture('volunteer_clicked', { source: 'home_how_to_help' });
      });
    }

    // Buy a shirt card
    var shirtLink = document.querySelector('#buy-shirt-home');
    if (shirtLink) {
      shirtLink.addEventListener('click', function () {
        window.posthog?.capture('buy_shirt_clicked');
      });
    }

    // "Coming up" row clicks — targeted by data attribute, not class chains.
    document.querySelectorAll('[data-upcoming-link]').forEach(function (el) {
      el.addEventListener('click', function () {
        window.posthog?.capture('upcoming_event_clicked', { title: el.getAttribute('data-event-title') });
      });
    });
  });
</script>

<script>
  import { eventIsUpcoming, pacificDate, upcomingHorizon } from "../lib/events";
  const section = document.querySelector<HTMLElement>('[data-upcoming-section]');
  const today = pacificDate();
  const horizon = upcomingHorizon(today);
  const visible = Array.from(section?.querySelectorAll<HTMLElement>('[data-event-date]') ?? [])
    .filter((row) => eventIsUpcoming(row.dataset.eventDate!, row.dataset.eventEnd, today, horizon))
    .slice(0, 5);
  visible.forEach((row) => row.classList.remove('hidden'));
  visible.at(-1)?.classList.add('border-b-0');
  if (visible.length) section?.classList.remove('hidden');
</script>
