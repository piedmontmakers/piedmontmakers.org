---
import BaseLayout from "../layouts/BaseLayout.astro";
import Ribbon from "../components/Ribbon.astro";
// The policy body lives in its own Markdown file so the board can revise the
// copy without touching page markup. Swap src/copy/privacy-policy.md and the
// page, the meta description, and the effective date all follow.
import { Content, frontmatter } from "../copy/privacy-policy.md";

// Frontmatter dates are plain "YYYY-MM-DD" strings. Parse as UTC and format in
// UTC so the day number doesn't shift backward on the West Coast.
const effective = new Date(`${frontmatter.effective}T00:00:00Z`).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<BaseLayout title={`${frontmatter.title} — Piedmont Makers`} description={frontmatter.description}>
  <section class="mx-auto max-w-7xl px-6 pt-12 md:pt-16 pb-4">
    <div class="max-w-3xl">
      <Ribbon color="ink">Legal</Ribbon>
      <h1
        class="mt-6 font-display font-bold text-pm-ink text-4xl md:text-5xl tracking-tight leading-[1.02]"
      >
        {frontmatter.title}
      </h1>
      <p class="mt-4 font-display text-sm uppercase tracking-[0.18em] text-pm-ink/60">
        Effective {effective}
      </p>
    </div>
  </section>

  <article class="mx-auto max-w-7xl px-6 pb-20">
    <div class="prose prose-lg max-w-3xl
      prose-headings:font-display prose-headings:tracking-tight prose-headings:text-pm-ink
      prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-4 prose-h2:font-bold
      prose-h3:text-2xl prose-h3:mt-8 prose-h3:mb-3 prose-h3:font-bold
      prose-p:font-body prose-p:text-pm-ink prose-p:leading-relaxed
      prose-a:text-pm-ink prose-a:underline prose-a:decoration-pm-red prose-a:underline-offset-4 prose-a:decoration-2
      hover:prose-a:text-pm-red
      prose-strong:font-semibold prose-strong:text-pm-ink
      prose-ul:list-disc prose-ul:pl-6 prose-li:my-1.5 prose-li:font-body prose-li:text-pm-ink
      prose-ol:list-decimal prose-ol:pl-6
      prose-hr:border-pm-ink/15">
      <Content />
    </div>
  </article>
</BaseLayout>
