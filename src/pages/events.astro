---
import { link } from "../lib/urls";
import BaseLayout from "../layouts/BaseLayout.astro";
import Ribbon from "../components/Ribbon.astro";
import PhotoCard from "../components/PhotoCard.astro";
import { stats } from "../data/stats";
import { programs } from "../data/programs";


---

<BaseLayout
  title="Events &amp; Programs — Piedmont Makers"
  description="Year-round Piedmont Makers events and programs: the annual School Maker Faire, popup maker spaces, Build Like a Girl, the 4th of July parade, a Destination Imagination pilot, and FIRST robotics teams across the East Bay."
>
  <!-- Hero -->
  <section class="mx-auto max-w-7xl px-6 pt-16 md:pt-20 pb-12">
    <Ribbon color="cyan">Events &amp; Programs</Ribbon>
    <h1 class="mt-6 font-display font-bold text-pm-ink text-5xl md:text-6xl tracking-tight leading-[0.98]">
      Come make something with us.
    </h1>
    <p class="mt-6 max-w-2xl text-lg md:text-xl text-pm-ink/75 leading-relaxed">
      Year-round community maker events and programs for kids and grown-ups. Each one a chance to make something together.
    </p>
    <p class="mt-4 max-w-2xl text-pm-ink/65 leading-relaxed">
      For specific upcoming dates, see the <a href={link("/calendar")} class="font-display font-semibold underline underline-offset-4 decoration-pm-red hover:text-pm-red">calendar</a>.
    </p>
  </section>

  <!-- Program cards -->
  <section class="mx-auto max-w-7xl px-6 pb-16">
    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-14">
      {programs.map((p) => (
        <li>
          <a href={link(p.href)} data-program={p.name} class="group block">
            <Ribbon color={p.color}>{p.name}</Ribbon>
            <p class="mt-3 font-display text-xs uppercase tracking-[0.18em] text-pm-ink/70">{p.when}</p>
            <h2 class="mt-2 font-display font-bold text-2xl md:text-3xl tracking-tight leading-tight">{p.headline}</h2>
            <div class="mt-5">
              <PhotoCard
                caption={p.caption}
                color={p.color}
                tilt={p.tilt}
                tape={p.tape}
                aspect="landscape"
                src={p.src}
                alt={p.alt}
              />
            </div>
            <p class="mt-3 px-1 text-pm-ink/80 leading-relaxed">{p.blurb}</p>
            <p class="mt-4 px-1 font-display font-semibold text-pm-ink group-hover:text-pm-red transition-colors">
              {p.cta}
            </p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- "By the way, we also run robotics" — de-emphasized callout to /robotics -->
  <section class="mx-auto max-w-7xl px-6 pb-20">
    <a
      href={link("/robotics")}
      data-program="Robotics"
      class="group grid grid-cols-1 md:grid-cols-[14rem_1fr] items-center gap-6 rounded-2xl border-[2px] border-pm-ink/15 bg-pm-paper px-5 py-5 md:px-6 md:py-6 transition-colors hover:border-pm-red/50"
    >
      <div class="overflow-hidden rounded-xl">
        <img
          src={link("/img/robotics/robotics-hero.jpg")}
          alt="Piedmont Makers FIRST robotics team members gathered around their robot."
          class="w-full aspect-[4/3] object-cover"
          loading="lazy"
        />
      </div>
      <div>
        <span class="font-marker text-2xl text-pm-red">psst &mdash;</span>
        <h2 class="mt-1 font-display font-bold text-2xl md:text-3xl tracking-tight leading-tight text-pm-ink">
          We like robots too.
        </h2>
        <p class="mt-2 text-pm-ink/75 leading-relaxed">
          We run the largest community-based youth robotics league in the United States. {stats.kidsOnTeams} kids on {stats.teams} FIRST teams, K through 12, across the East Bay.
        </p>
        <p class="mt-3 font-display font-semibold text-pm-ink group-hover:text-pm-red transition-colors">
          See the four levels &rarr;
        </p>
      </div>
    </a>
  </section>
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('[data-program]').forEach(function (el) {
      el.addEventListener('click', function () {
        window.posthog?.capture('program_card_clicked', {
          program_name: el.getAttribute('data-program')
        });
      });
    });
  });
</script>
