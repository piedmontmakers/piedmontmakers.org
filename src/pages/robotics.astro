---
import BaseLayout from "../layouts/BaseLayout.astro";
import Ribbon from "../components/Ribbon.astro";
import PhotoCard from "../components/PhotoCard.astro";
import FAQ from "../components/FAQ.astro";
import StatsBand from "../components/StatsBand.astro";
import { stats } from "../data/stats";
import { levels, coachResources } from "../data/robotics-levels";
import { faqItems } from "../data/robotics-faq";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const link = (path: string) => `${base}${path}`;

---

<BaseLayout
  title="Robotics — Piedmont Makers"
  description="FIRST Robotics teams for kids from kindergarten through high school. Open to East Bay students. Kids learn engineering by doing, and the older kids teach the younger ones."
>
  <!-- Hero -->
  <section class="mx-auto max-w-7xl px-6 pt-10 md:pt-12 pb-12">
    <div class="grid md:grid-cols-12 gap-10 md:gap-12 items-center">
      <div class="md:col-span-7">
        <Ribbon color="red">Robotics</Ribbon>
        <h1 class="mt-6 font-display font-bold text-pm-ink text-5xl md:text-6xl lg:text-7xl tracking-tight leading-[0.95]">
          From LEGO bricks to championship robots.
        </h1>
        <p class="mt-7 text-lg md:text-xl text-pm-ink/75 leading-relaxed">
          FIRST Robotics teams in 25+ cities across the East Bay, from LEGO bricks in 1st grade to 120-pound competition robots in high school. Kids learn engineering by doing, and the older ones teach the younger ones.
        </p>
        <p class="mt-4 text-base text-pm-ink/65 leading-relaxed">
          We operate the <strong class="text-pm-ink">largest community-based youth robotics league in the United States</strong>: {stats.kidsOnTeams} kids on {stats.teams} teams.
        </p>
      </div>
      <div class="md:col-span-5">
        <figure class="tilt-right">
          <div class="overflow-hidden rounded-3xl border-[3px] border-pm-ink shadow-[var(--shadow-card)]">
            <img
              src={`${base}/img/robotics/robotics-hero.jpg`}
              alt="An FIRST LEGO League Challenge team in yellow Piedmont Makers shirts at the UNEARTHED-season tournament — kids around a large LEGO competition table with the game map laid out, big crowd of spectators behind."
              class="w-full h-auto"
              loading="eager"
            />
          </div>
        </figure>
      </div>
    </div>
  </section>

  <!-- Impact stats band — matches the home page treatment -->
  <StatsBand
    pad="tight"
    stats={[
      { number: stats.kidsOnTeams, label: "kids on robotics teams" },
      { number: stats.girlsInLegoLeague, label: "girls in LEGO League" },
      { number: stats.titleOneShare, label: "from Title 1 schools" },
      { number: stats.outsidePiedmontShare, label: "from outside Piedmont" },
    ]}
  >
    <p slot="header" class="text-center font-display font-semibold text-base md:text-lg text-pm-cream max-w-2xl mx-auto leading-snug mb-7">
      STEAM shouldn&apos;t depend on your zip code or your family&apos;s income.
    </p>
  </StatsBand>

  <!-- The four levels -->
  <section class="mx-auto max-w-7xl px-6 pt-20 pb-24">
    <h2 class="font-display font-bold text-4xl md:text-5xl tracking-tight leading-tight">Pick the right team for your kid.</h2>
    <p class="mt-3 max-w-2xl text-lg text-pm-ink/75 leading-relaxed">
      LEGO League sign-ups run <strong>March through May</strong>; FTC and FRC open later, into the summer. Each level below shows whether its sign-ups are open right now. Financial aid is available; cost should not be a barrier.
    </p>

    <div class="mt-12 space-y-20">
      {levels.map((lvl, i) => (
        <div id={lvl.slug} class="grid md:grid-cols-12 gap-8 md:gap-10 scroll-mt-28">
          {/* On mobile the photo always comes AFTER the text block so a parent
              scrolling sees the level name and grade first, then the photo
              that represents it. On desktop we keep the alternating left/right
              layout via the md:order- classes. */}
          <div class={`md:col-span-5 order-last md:order-none ${i % 2 === 1 ? "md:order-2" : ""}`}>
            <PhotoCard
              caption={lvl.photoCaption}
              color={lvl.color}
              tilt={i % 2 === 0 ? "left" : "right"}
              aspect="square"
              src={lvl.photoSrc}
              alt={lvl.photoAlt}
            />
          </div>
          <div class={`md:col-span-7 ${i % 2 === 1 ? "md:order-1" : ""}`}>
            <Ribbon color={lvl.color}>{lvl.name}</Ribbon>
            <p class="mt-4 font-display font-bold text-2xl md:text-3xl tracking-tight text-pm-ink leading-tight">
              {lvl.ageLabel}
            </p>
            <p class="mt-5 text-lg leading-relaxed text-pm-ink/85">{lvl.blurb}</p>
            <p class="mt-3 text-pm-ink/75 leading-relaxed" set:html={lvl.detail} />

            <dl class="mt-6 grid grid-cols-2 gap-x-6 gap-y-3 text-sm">
              <div>
                <dt class="font-display text-xs uppercase tracking-[0.18em] text-pm-ink/70">Season</dt>
                <dd class="mt-0.5 font-semibold">{lvl.season}</dd>
              </div>
              <div>
                <dt class="font-display text-xs uppercase tracking-[0.18em] text-pm-ink/70">Cadence</dt>
                <dd class="mt-0.5 font-semibold">{lvl.cadence}</dd>
              </div>
              <div>
                <dt class="font-display text-xs uppercase tracking-[0.18em] text-pm-ink/70">Team size</dt>
                <dd class="mt-0.5 font-semibold">{lvl.teamSize}</dd>
              </div>
              <div>
                <dt class="font-display text-xs uppercase tracking-[0.18em] text-pm-ink/70">Cost</dt>
                <dd class="mt-0.5 font-semibold">{lvl.cost}</dd>
              </div>
            </dl>

            <div class="mt-7 flex flex-wrap gap-3">
              {lvl.registerOpen === false ? (
                <>
                  <span
                    aria-disabled="true"
                    class="ribbon bg-pm-ink/35 text-pm-cream/85 text-base cursor-not-allowed select-none"
                  >
                    {lvl.registerClosedLabel || "Registration opening soon"}
                  </span>
                  <a href={link("/#newsletter")} class="inline-flex items-center gap-2 rounded-full border-2 border-pm-ink px-5 py-2.5 font-display font-semibold text-pm-ink hover:bg-pm-ink hover:text-pm-cream transition-colors">
                    Get notified when sign-ups open →
                  </a>
                </>
              ) : (
                <a href={lvl.register} data-level={lvl.slug} data-register="true" class={`ribbon text-white text-base hover:opacity-90 transition-opacity ${
                  lvl.color === "red" ? "bg-pm-red hover:bg-pm-red-deep" :
                  lvl.color === "cyan" ? "bg-pm-cyan hover:bg-pm-cyan-deep" :
                  lvl.color === "purple" ? "bg-pm-purple hover:bg-pm-purple-deep" :
                  "bg-pm-ink hover:bg-pm-ink-soft"
                }`}>
                  Register on TeamSnap →
                </a>
              )}
              {lvl.openHousePresentation && (
                <a href={lvl.openHousePresentation} class="inline-flex items-center gap-2 rounded-full border-2 border-pm-ink px-5 py-2.5 font-display font-semibold text-pm-ink hover:bg-pm-ink hover:text-pm-cream transition-colors">
                  {lvl.openHouseLabel || "Open House slides →"}
                </a>
              )}
              {lvl.photoAlbum && (
                <a href={lvl.photoAlbum} class="inline-flex items-center gap-2 rounded-full border-2 border-pm-ink px-5 py-2.5 font-display font-semibold text-pm-ink hover:bg-pm-ink hover:text-pm-cream transition-colors">
                  {lvl.photoAlbumLabel || "Photo album →"}
                </a>
              )}
              {lvl.detailLink && (
                <a href={lvl.detailLink} class="inline-flex items-center gap-2 rounded-full border-2 border-pm-ink px-5 py-2.5 font-display font-semibold text-pm-ink hover:bg-pm-ink hover:text-pm-cream transition-colors">
                  {lvl.detailLinkLabel || "Team site →"}
                </a>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="mx-auto max-w-7xl px-6 pt-24 pb-12">
    <Ribbon color="cyan">FAQ</Ribbon>
    <h2 class="mt-6 font-display font-bold text-4xl md:text-5xl tracking-tight leading-tight">
      Parent questions, answered.
    </h2>
    <p class="mt-4 text-pm-ink/75 leading-relaxed">
      Still have something specific? Email <a href="mailto:robotics@piedmontmakers.org" class="font-display font-semibold underline underline-offset-4 decoration-pm-red hover:text-pm-red">robotics@piedmontmakers.org</a>.
    </p>

    <div class="mt-10">
      <FAQ items={faqItems} />
    </div>
  </section>

  <!-- Coach resources -->
  <section id="coaches" class="bg-pm-cream-2/60 scroll-mt-20">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="grid md:grid-cols-12 gap-10">
        <div class="md:col-span-5">
          <Ribbon color="purple">For coaches</Ribbon>
          <h2 class="mt-5 font-display font-bold text-4xl tracking-tight leading-tight">
            Coach training and open-house materials.
          </h2>
          <p class="mt-5 text-pm-ink/75 leading-relaxed">
            Coaching is the most volunteer-intensive thing we do. We supply lesson plans, training, and a community of coaches to learn from. These materials are open to anyone considering coaching.
          </p>
          <p class="mt-4 text-pm-ink/75 leading-relaxed">
            Interested but unsure? Email <a href="mailto:robotics@piedmontmakers.org" class="font-display font-semibold underline underline-offset-4 decoration-pm-red hover:text-pm-red">robotics@piedmontmakers.org</a>.
          </p>
        </div>
        <div class="md:col-span-7">
          <ul class="grid sm:grid-cols-2 gap-3">
            {coachResources.map((r) => (
              <li>
                <a href={r.url} class="group flex items-start justify-between gap-4 bg-pm-paper border-[3px] border-pm-ink p-5 hover:bg-white transition-colors">
                  <div>
                    <p class="font-display text-xs uppercase tracking-[0.18em] text-pm-ink/70">Google Drive</p>
                    <p class="mt-1 font-display font-bold text-base md:text-lg leading-tight tracking-tight">{r.title}</p>
                  </div>
                  <span class="font-display text-pm-red group-hover:translate-x-1 transition-transform shrink-0">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- A note for parents: two paths to registration -->
  <section class="mx-auto max-w-7xl px-6 py-20 md:py-24">
    <div class="rounded-3xl bg-pm-ink text-pm-cream p-10 md:p-14">
      <div class="text-center max-w-3xl mx-auto">
        <Ribbon color="red">A note for parents</Ribbon>
        <h2 class="mt-6 font-display font-bold text-4xl md:text-5xl tracking-tight">
          Two ways to register your kid.
        </h2>
        <p class="mt-4 text-pm-cream/85 leading-relaxed">
          Both are valid. The first one usually leads to a stronger season.
        </p>
      </div>

      <div class="mt-12 grid md:grid-cols-2 gap-6 md:gap-8">
        <div class="bg-pm-cream/[0.06] border border-pm-cream/15 rounded-2xl p-7 md:p-8">
          <span class="font-marker text-2xl text-pm-red">preferred</span>
          <h3 class="mt-1 font-display font-bold text-2xl md:text-3xl tracking-tight leading-tight">Register a pre-formed team</h3>
          <p class="mt-4 text-pm-cream/85 leading-relaxed">
            Round up your kid's friend group, assemble the team, and identify one parent as head coach and one as assistant. FIRST requires two coaches per team. Pre-formed teams give you more control over team composition and the support network of parents around the team, and they usually lead to better outcomes for the kids.
          </p>
        </div>

        <div class="bg-pm-cream/[0.06] border border-pm-cream/15 rounded-2xl p-7 md:p-8">
          <span class="font-marker text-2xl text-pm-cyan">no team yet?</span>
          <h3 class="mt-1 font-display font-bold text-2xl md:text-3xl tracking-tight leading-tight">Register as an individual</h3>
          <p class="mt-4 text-pm-cream/85 leading-relaxed">
            Tell us your kid's age, school, gender mix, and competitiveness preferences. We place kids on teams over the summer. Registration runs the whole window with no cap, so there's time to recruit friends and form a team yourself.
          </p>
          <p class="mt-3 text-sm text-pm-cream/75 leading-relaxed">
            You&apos;ll be asked whether you can serve as a parent coach. Motivated parent coaches are the difference between a team that forms and one that doesn&apos;t.
          </p>
        </div>
      </div>

      <p class="mt-10 text-center text-sm text-pm-cream/70">
        LEGO League sign-ups run March through May each year; FTC and FRC open later in the year. Questions? <a href="mailto:robotics@piedmontmakers.org" class="font-display font-semibold underline underline-offset-4 decoration-pm-red hover:text-pm-red">robotics@piedmontmakers.org</a>
      </p>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('[data-register="true"]').forEach(function (el) {
      el.addEventListener('click', function () {
        window.posthog?.capture('robotics_register_clicked', {
          level: el.getAttribute('data-level')
        });
      });
    });
  });
</script>
