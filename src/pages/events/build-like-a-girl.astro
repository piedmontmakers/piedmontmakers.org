---
import { link } from "../../lib/urls";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Ribbon from "../../components/Ribbon.astro";
import PhotoCard from "../../components/PhotoCard.astro";
import { getCollection } from "astro:content";
import { isoDate } from "../../lib/event-time";
import { pacificDate } from "../../lib/events";

// Next date comes from the events collection, so the page never shows a date
// that has already passed (as of the last deploy).
const today = pacificDate();
const nextEvent = (await getCollection("events", ({ data }) => data.program === "build-like-a-girl"))
  .filter((event) => isoDate(event.data.startDate) >= today)
  .sort((a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf())[0];
const nextDate = nextEvent?.data.startDate.toLocaleDateString("en-US", {
  weekday: "long", month: "long", day: "numeric", year: "numeric", timeZone: "UTC",
});
---

<BaseLayout
  title="Build Like a Girl — Piedmont Makers"
  description="An afternoon each January for girls curious about robotics, run by FTC Team 21483 Blinky Bots: a panel of student and professional roboticists, then a turn driving a competition robot."
>
  <section class="mx-auto max-w-7xl px-6 pt-16 md:pt-20 pb-8">
    <a href={link("/events")} class="font-display font-semibold text-pm-ink hover:text-pm-red underline-offset-4 hover:underline">
      ← All events
    </a>
    <div class="mt-6">
      <Ribbon color="purple">Build Like a Girl</Ribbon>
    </div>
    <h1 class="mt-6 font-display font-bold text-pm-ink text-5xl md:text-6xl tracking-tight leading-[0.98]">
      Meet the girls who build the robots.
    </h1>
    <p class="mt-7 max-w-2xl text-lg md:text-xl text-pm-ink/75 leading-relaxed">
      Build Like a Girl is an afternoon for girls who are curious about robotics. It&apos;s created and run by Blinky Bots, FTC Team 21483, a team of middle and high school students. Younger girls meet girls and women who build robots, ask them anything, then take the controls of a competition robot.
    </p>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-12">
    <div class="grid md:grid-cols-12 gap-8 items-center">
      <div class="md:col-span-7">
        <h2 class="font-display font-bold text-3xl md:text-4xl tracking-tight leading-tight">
          How the afternoon goes.
        </h2>
        <p class="mt-5 text-lg text-pm-ink/75 leading-relaxed">
          The heart of the afternoon is a panel: girls from middle and high school robotics teams alongside a professional roboticist. They talk about how they got started, what they build, and where robotics can lead, then take questions from the audience. No question is too basic.
        </p>
        <p class="mt-4 text-pm-ink/75 leading-relaxed">
          After the panel, the robots come out, and every girl who wants a turn gets to drive one.
        </p>
        <p class="mt-4 text-pm-ink/75 leading-relaxed">
          The 2026 event drew 61 girls.
          {nextEvent
            ? <>The next one is {nextDate}{nextEvent.data.location && <>, at the {nextEvent.data.location}</>}.</>
            : <>It happens once a year, in January.</>}
          Watch the <a href={link("/calendar")} class="font-display font-semibold underline underline-offset-4 decoration-pm-red hover:text-pm-red">events calendar</a> and <a href={link("/#newsletter")} class="font-display font-semibold underline underline-offset-4 decoration-pm-red hover:text-pm-red">the newsletter</a> for sign-up details.
        </p>
      </div>
      <div class="md:col-span-5">
        <PhotoCard
          caption="Blinky Bots demoing their FTC robot for a crowd of younger girls"
          color="purple"
          tilt="right"
          aspect="square"
          src="/img/programs/build-like-a-girl.jpg"
          alt="Members of FTC Team Blinky Bots in purple team sweatshirts demonstrating a competition robot on a table while a crowd of younger girls and parents watches."
        />
      </div>
    </div>
  </section>

  <section class="bg-pm-purple text-white mt-12">
    <div class="mx-auto max-w-7xl px-6 py-16 md:py-20">
      <Ribbon color="cream">Interested in helping out?</Ribbon>
      <h2 class="mt-5 font-display font-bold text-3xl md:text-4xl tracking-tight">
        We&apos;re looking for women in STEAM.
      </h2>
      <p class="mt-5 max-w-2xl text-lg text-white/90 leading-relaxed">
        Each year&apos;s panel pairs student roboticists with women who work in the field. The girls in the audience want to hear how you got started and what your work looks like day to day.
      </p>
      <p class="mt-4 max-w-2xl text-white/85 leading-relaxed">
        If you work in a STEAM field and would like to join a future panel, email <a href="mailto:hello@piedmontmakers.org" class="font-display font-semibold underline underline-offset-4 decoration-pm-cream hover:text-pm-cream">hello@piedmontmakers.org</a> and we&apos;ll connect you with Blinky Bots.
      </p>
    </div>
  </section>
</BaseLayout>
