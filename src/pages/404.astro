---
import { link } from "../lib/urls";
import BaseLayout from "../layouts/BaseLayout.astro";
import Ribbon from "../components/Ribbon.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const suggestions = [
  { href: "/", label: "Home" },
  { href: "/robotics", label: "Robotics" },
  { href: "/events", label: "Events" },
  { href: "/calendar", label: "Calendar" },
  { href: "/blog", label: "Blog" },
  { href: "/about-us", label: "About us" },
];

// Absolute URLs for the recovery document below: an agent may lift that
// markdown out of the page, where root-relative paths lose their origin.
const siteOrigin = (Astro.site?.toString() ?? "https://piedmontmakers.org/").replace(/\/$/, "");
const abs = (path: string) => siteOrigin + link(path);

// Machine-readable recovery document, embedded below as an inert
// <script type="text/markdown"> block. GitHub Pages serves this file for every
// unmatched URL and gives us no control over response headers, so we can't
// answer an agent's `Accept: text/markdown` with a real markdown response.
// Putting the markdown in the 404 body is the closest a static host gets:
// crawlers and agents that parse the body can still find their way back in.
const recoveryMarkdown = `# 404 — page not found

This URL does not exist on piedmontmakers.org. Nothing was moved or deleted;
the path was never valid. Start again from one of these:

- Site map (all pages): ${abs("/sitemap-index.xml")}
- Structured site overview for agents: ${abs("/llms.txt")}
- Blog feed (RSS): ${abs("/rss.xml")}
- Event feed (iCalendar): ${abs("/calendar.ics")}

Main sections:

${suggestions.map((s) => `- ${s.label}: ${abs(s.href)}`).join("\n")}

Piedmont Makers is a 501(c)(3) nonprofit running FIRST Robotics teams, a
community engineering lab, a school maker faire, popup maker spaces, and
Build Like a Girl across the East Bay. Contact: hello@piedmontmakers.org
`;
---

<BaseLayout
  title="Page not found — Piedmont Makers"
  description="The page you're looking for doesn't seem to exist. Makey's still looking though."
  noindex
>
  <section class="mx-auto max-w-7xl px-6 pt-16 pb-24 md:pt-24 md:pb-32">
    <div class="grid md:grid-cols-12 gap-10 md:gap-12 items-center">
      <div class="md:col-span-7 md:order-1">
        <Ribbon color="purple">404</Ribbon>
        <h1 class="mt-6 font-display font-bold text-pm-ink text-5xl md:text-6xl lg:text-7xl tracking-tight leading-[0.95]">
          Makey can&apos;t find that one.
        </h1>
        <p class="mt-6 max-w-xl text-lg md:text-xl text-pm-ink/75 leading-relaxed">
          The page might&apos;ve moved, or it might never have existed. Either way, here&apos;s where you can go instead.
        </p>
        <p class="mt-8 font-marker text-2xl text-pm-purple">try one of these</p>
        <ul class="mt-3 grid grid-cols-2 sm:grid-cols-3 gap-3 max-w-2xl">
          {suggestions.map((s) => (
            <li>
              <a
                href={link(s.href)}
                class="block bg-pm-paper border-[3px] border-pm-ink p-4 hover:bg-white hover:translate-y-[-2px] transition-all font-display font-semibold text-pm-ink"
              >
                → {s.label}
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-8 text-sm text-pm-ink/60 leading-relaxed">
          Looking for something specific? The
          <a href={link("/sitemap-index.xml")} class="underline underline-offset-4 decoration-pm-red hover:text-pm-red">site map</a>
          lists every page,
          <a href={link("/llms.txt")} class="underline underline-offset-4 decoration-pm-red hover:text-pm-red">llms.txt</a>
          summarizes the whole site, and the
          <a href={link("/rss.xml")} class="underline underline-offset-4 decoration-pm-red hover:text-pm-red">blog feed</a>
          and
          <a href={link("/calendar.ics")} class="underline underline-offset-4 decoration-pm-red hover:text-pm-red">calendar feed</a>
          are subscribable.
        </p>
      </div>
      <div class="md:col-span-5 md:order-2 flex items-center justify-center">
        <img
          src={`${base}/img/brand/makey.png`}
          alt="Makey, the Piedmont Makers mascot, hopping in place"
          class="w-56 md:w-72 lg:w-80 h-auto makey-dance"
          width="320"
          height="320"
        />
      </div>
    </div>
  </section>

  <!-- Recovery document for agents and crawlers. A non-JavaScript `type` means
       the browser never executes or renders this, but it puts literal markdown
       in the 404 response body. See the comment on recoveryMarkdown above. -->
  <script type="text/markdown" id="agent-recovery" is:inline set:html={recoveryMarkdown} />
</BaseLayout>

<style>
  /* Bouncy, slightly wobbly idle animation. Pivots from the bottom so
   * Makey feels grounded — like he's actually hopping in place.
   * The global prefers-reduced-motion rule in global.css kills it for
   * motion-sensitive users; the local rule below is belt-and-suspenders. */
  @keyframes makey-dance {
    0%   { transform: translateY(0) rotate(-3deg); }
    20%  { transform: translateY(-14px) rotate(4deg); }
    40%  { transform: translateY(0) rotate(-2deg); }
    60%  { transform: translateY(-9px) rotate(3deg); }
    80%  { transform: translateY(0) rotate(-3deg); }
    100% { transform: translateY(0) rotate(-3deg); }
  }
  .makey-dance {
    animation: makey-dance 1.6s ease-in-out infinite;
    transform-origin: bottom center;
    will-change: transform;
  }
  @media (prefers-reduced-motion: reduce) {
    .makey-dance {
      animation: none;
      transform: none;
    }
  }
</style>
