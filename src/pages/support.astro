---
// Standalone landing page for QR codes handed to prospective donors and
// volunteers. Deliberately not linked from Nav or Footer: people arrive here
// by scanning a code on a flyer, banner, or table card, almost always on a
// phone. Mobile layout is the primary target, not an afterthought.
import BaseLayout from "../layouts/BaseLayout.astro";
import Ribbon from "../components/Ribbon.astro";
import StatsBand from "../components/StatsBand.astro";
import PhotoCard from "../components/PhotoCard.astro";
import { stats } from "../data/stats";
import { DONATE, VOLUNTEER_EMAIL, VOLUNTEER_MAILTO, reach, givingLevels, whatSupportDoes } from "../data/support";

---

<BaseLayout
  title="Support Piedmont Makers"
  description="Piedmont Makers puts hands-on STEAM within reach of 1,000+ East Bay kids a year. Donate or volunteer to help keep it going."
>
  <!-- HERO -->
  <section class="mx-auto max-w-7xl px-6 pt-10 md:pt-16 pb-10 md:pb-14">
    <div class="grid md:grid-cols-12 gap-8 md:gap-12 items-center">
      <div class="md:col-span-7">
        <Ribbon color="red">Piedmont Makers</Ribbon>
        <h1 class="mt-6 font-display font-bold text-pm-ink text-4xl sm:text-5xl lg:text-6xl tracking-tight leading-[1.02]">
          {stats.kidsOnTeams} East Bay kids are building robots this season.
        </h1>
        <p class="mt-5 text-lg text-pm-ink/75 leading-relaxed">
          We're a volunteer-run 501(&zwnj;c)(3) putting hands-on STEAM within reach of families across the East Bay: FIRST Robotics teams from kindergarten through high school, a community engineering lab, a school maker faire, and grants that put tools into classrooms.
        </p>
        <p class="mt-3 font-marker text-2xl text-pm-purple">three ways to jump in &darr;</p>

        <!-- Primary actions sit above the fold on a phone. Full-width taps on
             mobile, side by side from sm up. -->
        <div class="mt-6 flex flex-col sm:flex-row gap-3">
          <a
            id="support-donate-hero"
            href={DONATE}
            class="ribbon bg-pm-red hover:bg-pm-red-deep text-white text-base justify-center text-center transition-colors"
          >
            Donate &rarr;
          </a>
          <a
            id="support-volunteer-hero"
            href={VOLUNTEER_MAILTO}
            class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-pm-ink px-5 py-2.5 font-display font-semibold text-pm-ink hover:bg-pm-ink hover:text-pm-cream transition-colors"
          >
            Volunteer &rarr;
          </a>
        </div>
      </div>

      <div class="md:col-span-5">
        <PhotoCard
          src="/img/robotics/robotics-hero.jpg"
          alt="A LEGO League Challenge team in yellow Piedmont Makers shirts around a large LEGO competition table at a tournament, with a crowd of spectators behind them."
          caption="Kids from across the East Bay at a season tournament."
          tilt="right"
          tape="left"
          aspect="landscape"
        />
      </div>
    </div>
  </section>

  <StatsBand
    stats={[
      { number: stats.kidsOnTeams, label: "kids on robotics teams" },
      { number: stats.schools, label: `schools across ${stats.cities} East Bay cities` },
      { number: "$25K+", label: "in teacher grants annually" },
      { number: stats.girlsInLegoLeague, label: "girls in LEGO League" },
    ]}
  />

  <!-- IMPACT -->
  <section class="mx-auto max-w-7xl px-6 pt-16 md:pt-20 pb-4">
    <div class="max-w-3xl">
      <Ribbon color="cyan">The impact</Ribbon>
      <h2 class="mt-5 font-display font-bold text-3xl md:text-4xl tracking-tight leading-tight">
        The largest community-based youth robotics league in the United States.
      </h2>
      <p class="mt-5 text-pm-ink/75 leading-relaxed">
        It runs on parent coaches, high school mentors, and donors who cover what registration fees don't. Kids learn engineering by building something that has to work on competition day, and the older kids teach the younger ones.
      </p>
    </div>

    <ul class="mt-10 grid grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-8">
      {reach.map((r) => (
        <li class="border-t-2 border-pm-ink/15 pt-4">
          <p class="font-display font-bold text-3xl md:text-4xl tracking-tight leading-none text-pm-ink">
            {r.number}
          </p>
          <p class="mt-2 text-sm text-pm-ink/70 leading-snug">{r.label}</p>
        </li>
      ))}
    </ul>

    <div class="mt-14 grid md:grid-cols-3 gap-6 md:gap-8">
      {whatSupportDoes.map((item) => (
        <div class="bg-pm-paper border-[3px] border-pm-ink p-6">
          <h3 class="font-display font-bold text-xl tracking-tight leading-tight">{item.title}</h3>
          <p class="mt-3 text-pm-ink/75 leading-relaxed">{item.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CALLS TO ACTION — three tiers, so a supporter with time, a supporter
       with a little, and a supporter with a lot each find their own door.
       The regional-infrastructure ask leads and gets the full-width card. -->
  <section id="ways" class="mx-auto max-w-7xl px-6 pt-16 md:pt-20 pb-20 md:pb-24 scroll-mt-20">
    <h2 class="font-display font-bold text-3xl md:text-4xl tracking-tight leading-tight">
      Three ways to back East Bay kids.
    </h2>

    <!-- TIER 1: major gift, regional infrastructure -->
    <div class="mt-8 rounded-3xl bg-pm-ink text-pm-cream p-8 md:p-12">
      <div class="grid lg:grid-cols-12 gap-8 lg:gap-12">
        <div class="lg:col-span-7">
          <Ribbon color="red">Lead gift</Ribbon>
          <h3 class="mt-5 font-display font-bold text-3xl md:text-4xl lg:text-5xl tracking-tight leading-tight">
            Keep the Bay Area's only community robotics field open.
          </h3>
          <p class="mt-5 text-pm-cream/85 leading-relaxed">
            Highlander Robotics 8033 built and runs the 10th Street practice field in Oakland, the only community-accessible full-size FIRST Robotics Competition field in the Bay Area. Piedmont Makers holds the multi-year lease as fiscal sponsor so the space stays open to everyone.
          </p>
          <p class="mt-4 text-pm-cream/85 leading-relaxed">
            In its first six months, 32 teams across FRC, FTC, and LEGO League logged 1,300+ practice hours there. Teams that used to drive to East Palo Alto for full-field practice now practice close to home. Gifts at this level cover rent, tooling, and field parts for every team that walks in, not only ours.
          </p>
        </div>

        <div class="lg:col-span-5">
          <p class="font-display text-xs uppercase tracking-[0.18em] text-pm-cream/60">
            Suggested levels
          </p>
          <div class="mt-4 grid grid-cols-2 gap-3">
            {givingLevels.map((amount) => (
              <a
                href={DONATE}
                data-give-level={amount}
                class="flex items-center justify-center rounded-2xl border-2 border-pm-cream/30 px-4 py-5 font-display font-bold text-2xl md:text-3xl tracking-tight text-pm-cream hover:bg-pm-red hover:border-pm-red transition-colors"
              >
                {amount}
              </a>
            ))}
          </div>
          <a
            id="support-infrastructure-main"
            href={DONATE}
            class="mt-4 flex items-center justify-center rounded-2xl bg-pm-red hover:bg-pm-red-deep px-5 py-4 font-display font-semibold text-white text-lg transition-colors"
          >
            Give to 10th Street &rarr;
          </a>
          <p class="mt-3 text-center text-sm text-pm-cream/70 leading-relaxed">
            Any amount welcome. To discuss a larger or multi-year commitment, email
            <a href={`mailto:${VOLUNTEER_EMAIL}`} class="font-display font-semibold underline underline-offset-4 decoration-pm-red hover:text-pm-red break-words">{VOLUNTEER_EMAIL}</a>.
          </p>
        </div>
      </div>
    </div>

    <!-- TIERS 2 + 3: smaller gift, and time -->
    <div class="mt-6 md:mt-8 grid md:grid-cols-2 gap-6 md:gap-8">
      <a
        id="support-donate-main"
        href={DONATE}
        class="group block rounded-3xl border-[3px] border-pm-ink bg-pm-paper p-8 md:p-10 hover:bg-white transition-colors"
      >
        <Ribbon color="purple">Give what you can</Ribbon>
        <h3 class="mt-5 font-display font-bold text-3xl tracking-tight leading-tight">
          Fund a kid's season.
        </h3>
        <p class="mt-4 text-pm-ink/75 leading-relaxed">
          Smaller gifts buy kits and parts, cover competition fees, and pay for the financial aid that keeps cost from deciding who gets to participate. A season for one kid runs $200 to $800 depending on the level.
        </p>
        <p class="mt-6 font-display font-semibold text-pm-ink group-hover:text-pm-red transition-colors break-words">
          Go to donate.piedmontmakers.org &rarr;
        </p>
        <p class="mt-2 font-marker text-xl text-pm-red">tax-deductible!</p>
      </a>

      <a
        id="support-volunteer-main"
        href={VOLUNTEER_MAILTO}
        class="group block rounded-3xl border-[3px] border-pm-ink bg-pm-paper p-8 md:p-10 hover:bg-white transition-colors"
      >
        <Ribbon color="cyan">Give your time</Ribbon>
        <h3 class="mt-5 font-display font-bold text-3xl tracking-tight leading-tight">
          Spend your season with the kids.
        </h3>
        <p class="mt-4 text-pm-ink/75 leading-relaxed">
          Coach a team, mentor at a tournament, judge at the maker faire, or lend a few hours where they're needed. No engineering background required, and no donation either. We train you.
        </p>
        <p class="mt-6 font-display font-semibold text-pm-ink group-hover:text-pm-cyan-deep transition-colors break-words">
          Email {VOLUNTEER_EMAIL} &rarr;
        </p>
        <p class="mt-2 font-marker text-xl text-pm-purple">we'll write back!</p>
      </a>
    </div>

    <p class="mt-10 text-center text-sm text-pm-ink/65 leading-relaxed">
      Piedmont Makers is a registered 501(&zwnj;c)(3) nonprofit. EIN 47-2831568. Serving the East Bay since 2014.
    </p>
  </section>

  <!-- Conversion tracking. Targets ids, not class chains, so restyling can't
       silently break attribution. -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var events = [
        ['support-donate-hero', 'donate_clicked', 'support_page_hero'],
        ['support-donate-main', 'donate_clicked', 'support_page_team'],
        ['support-infrastructure-main', 'donate_clicked', 'support_page_infrastructure'],
        ['support-volunteer-hero', 'volunteer_clicked', 'support_page_hero'],
        ['support-volunteer-main', 'volunteer_clicked', 'support_page_main'],
      ];
      events.forEach(function (entry) {
        var el = document.getElementById(entry[0]);
        if (!el) return;
        el.addEventListener('click', function () {
          window.posthog?.capture(entry[1], { source: entry[2] });
        });
      });

      // Suggested-level chips: same event, tagged with the level clicked so we
      // can see which ask size lands even though Square can't prefill it.
      document.querySelectorAll('[data-give-level]').forEach(function (el) {
        el.addEventListener('click', function () {
          window.posthog?.capture('donate_clicked', {
            source: 'support_page_infrastructure',
            amount: el.getAttribute('data-give-level'),
          });
        });
      });
    });
  </script>
</BaseLayout>
