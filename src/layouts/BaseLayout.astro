---
import { asset } from "../lib/urls";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PostHog from "../components/PostHog.astro";

interface Props {
  title: string;
  description?: string;
  /** Optional path to a per-page Open Graph image. Falls back to the brand default. */
  ogImage?: string;
  /** When true (on blog posts) emit article-specific OG type. */
  ogType?: "website" | "article";
  /**
   * Page-level JSON-LD (schema.org), emitted alongside the site-wide
   * NonprofitOrganization schema. Pass one object or an array; pages build
   * these from their source data so structured data always tracks content.
   */
  structuredData?: object | object[];
  /** ISO dates for article: meta tags; only emitted when ogType is "article". */
  publishedTime?: string;
  modifiedTime?: string;
  /**
   * Keep the page out of search indexes. Also suppresses the canonical link:
   * GitHub Pages serves 404.html for every unmatched URL, so a canonical there
   * would point thousands of missing paths at /404.
   */
  noindex?: boolean;
}

const {
  title,
  description = "Piedmont Makers — a 501(‌c)(3) supporting STEAM education and maker culture across the East Bay.",
  ogImage,
  ogType = "website",
  structuredData,
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;

const pageSchemas = structuredData
  ? (Array.isArray(structuredData) ? structuredData : [structuredData])
  : [];


// Build absolute URLs for canonical / OG tags. Astro.site is set in
// astro.config.mjs and flips between the GH Pages staging origin and the
// apex domain via USE_CUSTOM_DOMAIN.
const siteOrigin = (Astro.site?.toString() ?? "https://piedmontmakers.org/").replace(/\/$/, "");
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? "https://piedmontmakers.org/").toString();
const ogImageAbsolute = ogImage
  ? new URL(asset(ogImage), Astro.site ?? "https://piedmontmakers.org/").toString()
  : new URL(asset("/img/brand/logo.png"), Astro.site ?? "https://piedmontmakers.org/").toString();

// JSON-LD Organization data so search engines can attach Piedmont Makers
// the entity to any page on the site.
const orgSchema = {
  "@context": "https://schema.org",
  // Multi-typed on purpose. NonprofitOrganization is a schema.org *pending*
  // extension type, so consumers that only know the core vocabulary can't
  // resolve it to Organization and report the site as having no identity
  // type at all. Listing both keeps the nonprofit signal and gives those
  // consumers the core type they look for.
  "@type": ["Organization", "NonprofitOrganization"],
  // Stable entity IRI so other schema blocks can reference the org by @id.
  "@id": siteOrigin + "/#organization",
  name: "Piedmont Makers",
  legalName: "Piedmont Makers",
  url: siteOrigin + "/",
  logo: new URL(asset("/img/brand/logo.png"), Astro.site ?? "https://piedmontmakers.org/").toString(),
  // No U+200C here, unlike the rendered copy: JSON-LD is never displayed, so
  // the Manrope (c) workaround would only put an invisible character into
  // text that agents read literally.
  description: "501(c)(3) nonprofit running FIRST Robotics teams, a community engineering lab, a school maker faire, popup maker spaces, and Build Like a Girl across the East Bay.",
  foundingDate: "2014",
  taxID: "47-2831568",
  nonprofitStatus: "Nonprofit501c3",
  email: "hello@piedmontmakers.org",
  // City-level only, deliberately. Piedmont Makers is volunteer-run with no
  // office; a street address here would be some board member's house.
  address: {
    "@type": "PostalAddress",
    addressLocality: "Piedmont",
    addressRegion: "CA",
    postalCode: "94611",
    addressCountry: "US",
  },
  contactPoint: [
    {
      "@type": "ContactPoint",
      contactType: "general inquiries",
      email: "hello@piedmontmakers.org",
      areaServed: "US",
      availableLanguage: "English",
    },
    {
      "@type": "ContactPoint",
      contactType: "privacy",
      email: "privacy@piedmontmakers.org",
      areaServed: "US",
      availableLanguage: "English",
    },
  ],
  areaServed: { "@type": "AdministrativeArea", name: "East Bay, California" },
  // Every public profile from the footer, so knowledge graphs can reconcile
  // the organization entity. scripts/check-structured-data.mjs asserts this
  // list stays in sync with Footer.astro's social links.
  sameAs: [
    "https://www.instagram.com/piedmontmakers/",
    "https://www.linkedin.com/company/piedmont-makers",
    "https://www.youtube.com/channel/UCwhVj67myzJX6X7ZxCxai6g",
    "https://x.com/piedmontmakers",
    "https://www.facebook.com/groups/piedmontmakers",
  ],
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <link rel="canonical" href={canonicalUrl} />
    )}

    <!-- Open Graph (Facebook, LinkedIn, iMessage previews) -->
    <meta property="og:site_name" content="Piedmont Makers" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:locale" content="en_US" />
    {ogType === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === "article" && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    <!-- Feed auto-discovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Piedmont Makers — Blog"
      href={asset("/rss.xml")}
    />

    <!-- Icons / manifest -->
    <link rel="icon" type="image/x-icon" href={asset("/favicon.ico")} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={asset("/favicon-32.png")} />
    <link rel="icon" type="image/png" sizes="16x16" href={asset("/favicon-16.png")} />
    <link rel="apple-touch-icon" sizes="180x180" href={asset("/apple-touch-icon.png")} />
    <link rel="manifest" href={asset("/site.webmanifest")} />
    <meta name="theme-color" content="#92278F" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=Manrope:wght@400;500;600;700;800&family=Caveat:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Structured data: NonprofitOrganization -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {pageSchemas.map((schema) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <PostHog />
  </head>
  <body class="bg-pm-paper text-pm-ink antialiased">
    <!-- Skip-to-content for keyboard + screen-reader users. Hidden by
         default; appears in the top-left when focused. -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[100] focus:rounded focus:bg-pm-ink focus:px-4 focus:py-2 focus:font-display focus:font-semibold focus:text-pm-cream"
    >
      Skip to main content
    </a>
    <Nav />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
